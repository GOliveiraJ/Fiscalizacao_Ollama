'use client';

import { useState, useEffect, useMemo } from 'react';
import { 
  BarChart3, Search, ClipboardCheck, FolderOpen, Bot, Eye, 
  ShieldCheck, AlertTriangle, PackageSearch, Store, Activity,
  LogOut, BadgeCheck, User, Lock, LogIn, Plus, X, Camera, 
  CheckCircle, FileSpreadsheet, FileText, Trash2, Save, ScanLine,
  PieChart, Building2, TrendingUp, Filter
} from 'lucide-react';

export default function AppLayout() {
  // ==========================================
  // 1. ESTADOS DE AUTENTICAÇÃO E LOGS
  // ==========================================
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [fiscalName, setFiscalName] = useState('');
  const [inputUser, setInputUser] = useState('');
  const [inputPass, setInputPass] = useState('');
  const [inputName, setInputName] = useState('');
  const [loginError, setLoginError] = useState('');
  const [isLoggingIn, setIsLoggingIn] = useState(false);

  const [activeTab, setActiveTab] = useState('dashboard');

  const registrarLog = async (fiscal: string, acao: string, detalhes: string) => {
    try {
      await fetch('http://127.0.0.1:8000/api/log', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fiscal, acao, detalhes }),
      });
    } catch (e) {
      console.error("Erro ao registrar log", e);
    }
  };

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginError('');
    setIsLoggingIn(true);
    await new Promise(r => setTimeout(r, 500));

    if (inputUser === 'GGTAB' && inputPass === 'CCTAB' && inputName.trim() !== '') {
      setFiscalName(inputName.trim());
      setIsAuthenticated(true);
      await registrarLog(inputName.trim(), 'Login', 'Acesso concedido à plataforma.');
    } else {
      setLoginError('Credenciais inválidas ou nome não preenchido.');
    }
    setIsLoggingIn(false);
  };

  const handleLogout = async () => {
    await registrarLog(fiscalName, 'Logout', 'Utilizador saiu do sistema.');
    setIsAuthenticated(false);
    setInputPass('');
  };

  // ==========================================
  // 2. ESTADOS DO DASHBOARD, OPERAÇÕES E LOGS
  // ==========================================
  const [dashData, setDashData] = useState({ total_operacoes: 0, total_lojas: 0, total_itens: 0, total_ilegais: 0 });
  const [loadingDash, setLoadingDash] = useState(false);
  const [logsAuditoria, setLogsAuditoria] = useState<any[]>([]);
  const [loadingLogs, setLoadingLogs] = useState(false);

  // Filtros Interativos do BI (Slicers)
  const [filtroOperacaoBI, setFiltroOperacaoBI] = useState<string>('TODAS');
  const [filtroNaturezaBI, setFiltroNaturezaBI] = useState<string>('TODAS');

  // Histórico e Operações
  const [historicoOps, setHistoricoOps] = useState<any[]>([]);
  const [opSelecionadaIdx, setOpSelecionadaIdx] = useState<number>(0);
  const [loadingHistorico, setLoadingHistorico] = useState(false);
  const [baixandoArquivo, setBaixandoArquivo] = useState(false);
  const [lojaAlvoEdicaoIdx, setLojaAlvoEdicaoIdx] = useState<number | null>(null);

  const carregarHistoricoNuvem = async () => {
    setLoadingHistorico(true);
    try {
      const res = await fetch('http://127.0.0.1:8000/api/operacoes');
      if (res.ok) {
        const data = await res.json();
        const opsNuvem = data.operacoes || [];
        setHistoricoOps(prev => {
          const mapaLocal = new Map(prev.map(o => [o.operacao_id, o]));
          opsNuvem.forEach((opNuvem: any) => {
            if (!mapaLocal.has(opNuvem.operacao_id)) {
              mapaLocal.set(opNuvem.operacao_id, opNuvem);
            }
          });
          return Array.from(mapaLocal.values());
        });
      }
    } catch (e) {
      console.error(e);
    } finally {
      setLoadingHistorico(false);
    }
  };

  const carregarDashboard = async () => {
    setLoadingDash(true);
    try {
      await carregarHistoricoNuvem();
      const res = await fetch('http://127.0.0.1:8000/api/dashboard');
      if (res.ok) setDashData(await res.json());
    } catch (error) {
      console.error(error);
    } finally {
      setLoadingDash(false);
    }
  };

  const carregarLogs = async () => {
    setLoadingLogs(true);
    try {
      const res = await fetch('http://127.0.0.1:8000/api/logs');
      if (res.ok) {
        const data = await res.json();
        setLogsAuditoria(data.logs || []);
      }
    } catch (e) {
      console.error(e);
    } finally {
      setLoadingLogs(false);
    }
  };

  // ==========================================
  // 3. ESTADOS DE PRODUTOS (BASE + SUPABASE)
  // ==========================================
  const [produtos, setProdutos] = useState<any[]>([]);
  const [loadingProdutos, setLoadingProdutos] = useState(false);
  const [buscaProduto, setBuscaProduto] = useState('');
  const [showModalCadastro, setShowModalCadastro] = useState(false);

  const [cadMacro, setCadMacro] = useState('');
  const [cadTipo, setCadTipo] = useState('');
  const [cadNovoTipo, setCadNovoTipo] = useState('');
  const [cadMarca, setCadMarca] = useState('');
  const [cadCnpj, setCadCnpj] = useState('');

  const carregarProdutos = async () => {
    setLoadingProdutos(true);
    try {
      const res = await fetch('http://127.0.0.1:8000/api/produtos');
      if (res.ok) {
        const data = await res.json();
        setProdutos(data.produtos || []);
      }
    } catch (e) {
      console.error(e);
    } finally {
      setLoadingProdutos(false);
    }
  };

  useEffect(() => {
    if (isAuthenticated) {
      carregarProdutos();
      if (activeTab === 'dashboard') carregarDashboard();
      if (activeTab === 'historico') carregarHistoricoNuvem();
      if (activeTab === 'logs') carregarLogs();
    }
  }, [activeTab, isAuthenticated]);

  const tiposPadraoDEF = [
    "Cigarros eletrônicos (Vapes e Pods)",
    "Cigarros aquecidos ou tabaco aquecido",
    "Vaporizadores de ervas secas",
    "Produtos híbridos",
    "Essências e Juices (Líquidos para DEF)"
  ];

  const tiposPadraoTabaco = [
    "🚬 Cigarros (Filtro/Kretek)",
    "🕴️ Charutos",
    "🌿 Fumo Desfiado",
    "🌾 Cigarro de Palha",
    "🌬️ Fumo para Narguilé",
    "🪈 Fumo para Cachimbo"
  ];

  const opcoesTipoCadastro = cadMacro.includes('DEF') 
    ? [...tiposPadraoDEF, "+ Criar Novo Tipo"] 
    : (cadMacro.includes('Tabacos') ? [...tiposPadraoTabaco, "+ Criar Novo Tipo"] : []);
  
  const statusAutomaticoCadastro = cadMacro.includes('Registrados') ? 'Regular' : (cadMacro !== '' ? 'Ilegal/Apreensão' : '');

  const submeterCadastroGlobal = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!cadMacro || !cadTipo || !cadMarca) return;
    const tipoFinal = cadTipo === '+ Criar Novo Tipo' ? cadNovoTipo : cadTipo;
    const chaveDb = cadMacro.includes('DEF') ? "💨 DEF (Dispositivos Eletrônicos para Fumar)" : "🍂 TABACOS E DERIVADOS";

    try {
      const res = await fetch('http://127.0.0.1:8000/api/produtos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          categoria: chaveDb, tipo: tipoFinal, produto: cadMarca,
          cnpj: cadCnpj || 'Sem CNPJ', status: statusAutomaticoCadastro
        })
      });
      if (res.ok) {
        setShowModalCadastro(false);
        setCadMacro(''); setCadTipo(''); setCadMarca(''); setCadCnpj(''); setCadNovoTipo('');
        await carregarProdutos();
        await registrarLog(fiscalName, 'Novo Produto Cadastrado', `Marca '${cadMarca}' salva na nuvem.`);
        alert(`✅ Marca '${cadMarca}' adicionada com sucesso!`);
      }
    } catch (e) {
      alert("Erro de conexão com a API.");
    }
  };

  const produtosFiltradosTabela = produtos.filter(p => 
    p.produto?.toLowerCase().includes(buscaProduto.toLowerCase()) || 
    p.cnpj?.toLowerCase().includes(buscaProduto.toLowerCase()) ||
    p.tipo?.toLowerCase().includes(buscaProduto.toLowerCase())
  );

  // ==========================================
  // 4. ESTADOS DA NOVA FISCALIZAÇÃO + OCR
  // ==========================================
  const [operacaoId, setOperacaoId] = useState('');
  const [lojasAuditadas, setLojasAuditadas] = useState<any[]>([]);
  const [lojaAtiva, setLojaAtiva] = useState<any>(null);
  const [isSyncing, setIsSyncing] = useState(false);

  const [showModalLoja, setShowModalLoja] = useState(false);
  const [formNumLoja, setFormNumLoja] = useState<number>(1);
  const [formNomeLoja, setFormNomeLoja] = useState('');

  const [showModalInfracao, setShowModalInfracao] = useState(false);
  const [infMacro, setInfMacro] = useState('');
  const [infTipo, setInfTipo] = useState('');
  const [infProd, setInfProd] = useState('');
  const [infQtd, setInfQtd] = useState<number>(1);
  const [infNovoNome, setInfNovoNome] = useState('');
  const [infNovoCnpj, setInfNovoCnpj] = useState('');
  const [infNovoTipo, setInfNovoTipo] = useState('');

  const [foto1Preview, setFoto1Preview] = useState<string | null>(null);
  const [foto2Preview, setFoto2Preview] = useState<string | null>(null);
  const [loadingOcr, setLoadingOcr] = useState(false);
  const [ocrFeedback, setOcrFeedback] = useState('');

  const isDef = infMacro.includes("DEF");
  const isPropaganda = infMacro.includes("Propaganda") && !infMacro.includes("Apreensão e Propaganda");
  const isIlegal = infMacro.includes("Irregulares");
  const isAmbos = infMacro.includes("Apreensão e Propaganda");
  const chaveDbInf = isDef ? "💨 DEF (Dispositivos Eletrônicos para Fumar)" : "🍂 TABACOS E DERIVADOS";

  const tiposDinamicosNoBanco = Array.from(new Set(produtos.filter(p => p.categoria === chaveDbInf).map(p => p.tipo)));
  const listaTiposBase = isDef 
    ? Array.from(new Set([...tiposPadraoDEF, ...tiposDinamicosNoBanco]))
    : Array.from(new Set([...tiposPadraoTabaco, ...tiposDinamicosNoBanco]));

  const opcoesTipoInfracao = [...listaTiposBase];
  if (isIlegal || isDef || isAmbos) opcoesTipoInfracao.push("⚠️ OUTRO TIPO / MARCA NOVA");

  const isNovoTipoSelecionado = infTipo.includes("⚠️");
  const produtosDoTipo = produtos.filter(p => p.categoria === chaveDbInf && p.tipo === infTipo);
  let produtosFiltradosInfracao: any[] = [];
  if (!isNovoTipoSelecionado && infTipo !== '') {
    if (isPropaganda) produtosFiltradosInfracao = produtosDoTipo.filter(p => !p.status.includes("Ilegal"));
    else if (isIlegal || isAmbos) produtosFiltradosInfracao = produtosDoTipo.filter(p => p.status.includes("Ilegal"));
    else produtosFiltradosInfracao = produtosDoTipo;
  }

  const objProdutoSelecionado = produtosDoTipo.find(p => p.produto === infProd);
  const cnpjBancoSelecionado = objProdutoSelecionado ? objProdutoSelecionado.cnpj : "Sem CNPJ";

  // =========================================================================
  // 5. MOTOR ANALÍTICO DE BI (CONSOLIDAÇÃO EM TEMPO REAL PARA OS GRÁFICOS)
  // =========================================================================
  const biAnalytics = useMemo(() => {
    const todasOps = [...historicoOps];
    if (operacaoId && (lojasAuditadas.length > 0 || lojaAtiva)) {
      const lojasTemp = [...lojasAuditadas];
      if (lojaAtiva) lojasTemp.push(lojaAtiva);
      todasOps.unshift({ operacao_id: `${operacaoId} (Ativa)`, fiscal: fiscalName, lojas: lojasTemp });
    }

    const itensPlanos: any[] = [];
    const opsUnicas = new Set<string>();
    const lojasUnicas = new Set<string>();

    todasOps.forEach(op => {
      if (filtroOperacaoBI !== 'TODAS' && op.operacao_id !== filtroOperacaoBI) return;
      opsUnicas.add(op.operacao_id);

      (op.lojas || []).forEach((lj: any) => {
        const nomeLojaFull = `Loja ${lj.numero} - ${lj.nome}`;
        lojasUnicas.add(`${op.operacao_id}_${nomeLojaFull}`);

        (lj.itens || []).forEach((it: any) => {
          const st = String(it.status || '');
          const cat = String(it.categoria || '');

          // Classificação da Modalidade de Apreensão / Infração
          let modalidade = 'Apreensão de Tabaco s/ Registro';
          if (cat.includes('DEF')) modalidade = 'Apreensão de DEF (Vape/Pod)';
          else if (st.includes('Apreensão e Propaganda')) modalidade = 'Apreensão + Propaganda Ilegal';
          else if (st.includes('Propaganda')) modalidade = 'Autuação (Propaganda Irregular)';

          if (filtroNaturezaBI !== 'TODAS' && modalidade !== filtroNaturezaBI) return;

          // Extração inteligente da Empresa / Fabricante
          const prodRaw = String(it.produto || 'Produto S/ Nome');
          const matchFab = prodRaw.match(/^(.*?)\s*\((.*?)\)$/);
          let marcaLimpa = prodRaw;
          let empresaNome = 'Fabricante Não Identificado / Clandestino';

          if (matchFab) {
            marcaLimpa = matchFab[1].trim();
            const parentesesTxt = matchFab[2].trim();
            if (cat.includes('DEF') || it.cnpj === 'Sem CNPJ' || String(it.cnpj).includes('Ilegal')) {
              empresaNome = `Clandestino / DEF (${marcaLimpa})`;
            } else {
              empresaNome = parentesesTxt;
            }
          } else if (it.cnpj && it.cnpj !== 'Sem CNPJ') {
            empresaNome = `CNPJ: ${it.cnpj}`;
          } else if (cat.includes('DEF')) {
            empresaNome = `Importação Ilegal DEF (${marcaLimpa})`;
          }

          itensPlanos.push({
            operacao_id: op.operacao_id,
            loja: nomeLojaFull,
            categoria: cat,
            tipo: String(it.tipo || 'Outros').replace(/🚬 |🕴️ |🌿 |🌾 |🌬️ |🪈 /g, ''),
            produto: prodRaw,
            marca: marcaLimpa,
            empresa: empresaNome,
            cnpj: String(it.cnpj || 'Sem CNPJ'),
            status: st,
            modalidade,
            quantidade: Number(it.quantidade || 0)
          });
        });
      });
    });

    const totalItens = itensPlanos.reduce((acc, cur) => acc + cur.quantidade, 0);
    const totalInfracoes = itensPlanos
      .filter(i => i.status.toLowerCase().includes('ilegal') || i.status.toLowerCase().includes('propaganda'))
      .reduce((acc, cur) => acc + cur.quantidade, 0);

    const agruparESomar = (chave: string, limite = 6) => {
      const mapa = new Map<string, { nome: string; qtd: number; extra?: string }>();
      itensPlanos.forEach(item => {
        const k = item[chave] || 'Não Informado';
        const atual = mapa.get(k) || { nome: k, qtd: 0, extra: item.cnpj };
        atual.qtd += item.quantidade;
        mapa.set(k, atual);
      });
      return Array.from(mapa.values())
        .sort((a, b) => b.qtd - a.qtd)
        .slice(0, limite);
    };

    const porModalidade = agruparESomar('modalidade', 5);
    const topProdutos = agruparESomar('marca', 6);
    const topEmpresas = agruparESomar('empresa', 6);
    const porTipo = agruparESomar('tipo', 6);
    const topLojas = agruparESomar('loja', 5);

    return {
      listaOpsDisponiveis: todasOps.map(o => o.operacao_id),
      totalOperacoes: opsUnicas.size || dashData.total_operacoes,
      totalLojas: lojasUnicas.size || dashData.total_lojas,
      totalItens: totalItens || dashData.total_itens,
      totalInfracoes: totalInfracoes || dashData.total_ilegais,
      temDadosDetalhados: itensPlanos.length > 0,
      porModalidade,
      topProdutos,
      topEmpresas,
      porTipo,
      topLojas
    };
  }, [historicoOps, operacaoId, lojasAuditadas, lojaAtiva, filtroOperacaoBI, filtroNaturezaBI, dashData, fiscalName]);

  // ==========================================
  // 6. FUNÇÕES DE OPERAÇÃO, OCR, PDF E EXCEL
  // ==========================================
  const executarOcrCnpj = async () => {
    if (!foto2Preview) return;
    setLoadingOcr(true);
    setOcrFeedback('');
    try {
      const res = await fetch('http://127.0.0.1:8000/api/ocr-cnpj', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imagem_base64: foto2Preview })
      });
      const data = await res.json();
      if (data.sucesso) {
        setInfNovoCnpj(data.cnpj);
        if (data.produto_sugerido && produtosFiltradosInfracao.some(p => p.produto === data.produto_sugerido)) {
          setInfProd(data.produto_sugerido);
        }
        setOcrFeedback(`🤖 ${data.mensagem}`);
      } else {
        setOcrFeedback(`⚠️ ${data.mensagem}`);
      }
    } catch (e) {
      setOcrFeedback('⚠️ Erro ao comunicar com o motor OCR no Python.');
    } finally {
      setLoadingOcr(false);
    }
  };

  const iniciarOperacao = () => {
    const agora = new Date();
    const timestamp = `${agora.getFullYear()}${String(agora.getMonth() + 1).padStart(2, '0')}${String(agora.getDate()).padStart(2, '0')}${String(agora.getHours()).padStart(2, '0')}${String(agora.getMinutes()).padStart(2, '0')}`;
    const id = `OP-${historicoOps.length + 1}-${timestamp}`;
    setOperacaoId(id);
    setLojasAuditadas([]);
    registrarLog(fiscalName, 'Operação Iniciada', `Criou a ${id}`);
  };

  const entrarNaLoja = (e: React.FormEvent) => {
    e.preventDefault();
    if (!formNomeLoja.trim()) return;
    setLojaAtiva({ numero: formNumLoja || 1, nome: formNomeLoja.trim(), itens: [] });
    setShowModalLoja(false);
    setFormNumLoja(prev => prev + 1);
    setFormNomeLoja('');
  };

  const encerrarAuditoriaLoja = () => {
    if (lojaAtiva) {
      registrarLog(fiscalName, 'Loja Concluída', `Fechou a Loja ${lojaAtiva.numero}`);
      setLojasAuditadas(prev => [...prev, lojaAtiva]);
      setLojaAtiva(null);
    }
  };

  const limparFormularioInfracao = () => {
    setInfMacro(''); setInfTipo(''); setInfProd(''); setInfQtd(1);
    setInfNovoNome(''); setInfNovoCnpj(''); setInfNovoTipo('');
    setFoto1Preview(null); setFoto2Preview(null); setOcrFeedback('');
    setLojaAlvoEdicaoIdx(null);
  };

  const confirmarInfracao = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!infMacro || !infTipo) return;

    const horaAtual = new Date().toLocaleTimeString('pt-BR');
    const limparEmojisTipo = (str: string) => str.replace(/🚬 |🕴️ |🌿 |🌾 |🌬️ |🪈 /g, "");
    let novoItem: any = null;

    if (isNovoTipoSelecionado || infProd === "⚠️ CADASTRAR NOVA MARCA ILEGAL") {
      const nomeFinal = infNovoNome.trim() || "Produto S/ Nome";
      const cnpjFinal = infNovoCnpj.trim() || "Sem CNPJ";
      const tipoFinal = !isNovoTipoSelecionado ? infTipo : (infNovoTipo.trim() || "Outros");
      const statusFinal = isAmbos ? "Ilegal/Apreensão e Propaganda" : "Ilegal/Apreensão";
      const catLimpa = isAmbos ? "Tabaco Irregular (Sem Registro + Propaganda)" : (isIlegal ? "Tabaco Irregular (Sem Registro)" : "DEF");

      try {
        await fetch('http://127.0.0.1:8000/api/produtos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ categoria: chaveDbInf, tipo: tipoFinal, produto: nomeFinal, cnpj: cnpjFinal, status: "Ilegal/Apreensão" })
        });
        await carregarProdutos();
      } catch (err) {
        console.error(err);
      }

      novoItem = {
        categoria: catLimpa, tipo: limparEmojisTipo(tipoFinal), produto: nomeFinal,
        status: statusFinal, cnpj: cnpjFinal, quantidade: infQtd, hora: horaAtual,
        foto1_base64: foto1Preview, foto2_base64: foto2Preview
      };
    } else {
      if (!infProd) return;
      let statusBanco = "Ilegal/Apreensão";
      let catLimpa = "DEF";
      if (isPropaganda) { statusBanco = "Autuação (Propaganda Irregular)"; catLimpa = "Propaganda Irregular (Produto Registrado)"; }
      else if (isAmbos) { statusBanco = "Ilegal/Apreensão e Propaganda"; catLimpa = "Tabaco Irregular (Sem Registro + Propaganda)"; }
      else if (isIlegal) { statusBanco = "Ilegal/Apreensão"; catLimpa = "Tabaco Irregular (Sem Registro)"; }

      novoItem = {
        categoria: catLimpa, tipo: limparEmojisTipo(infTipo), produto: infProd,
        status: statusBanco, cnpj: cnpjBancoSelecionado.replace(" [Ilegal]", ""),
        quantidade: infQtd, hora: horaAtual,
        foto1_base64: foto1Preview, foto2_base64: foto2Preview
      };
    }

    if (lojaAlvoEdicaoIdx !== null) {
      setHistoricoOps(prev => {
        const copia = [...prev];
        copia[opSelecionadaIdx].lojas[lojaAlvoEdicaoIdx].itens.push(novoItem);
        return copia;
      });
    } else {
      setLojaAtiva((prev: any) => ({ ...prev, itens: [...prev.itens, novoItem] }));
    }

    setShowModalInfracao(false);
    limparFormularioInfracao();
  };

  const finalizarOperacaoTotal = async () => {
    if (lojasAuditadas.length === 0) return;
    setIsSyncing(true);
    const novaOpCompleta = {
      operacao_id: operacaoId,
      fiscal: fiscalName,
      data_hora: new Date().toISOString(),
      lojas: lojasAuditadas
    };

    try {
      const res = await fetch('http://127.0.0.1:8000/api/salvar-operacao', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(novaOpCompleta)
      });
      if (res.ok) {
        const respData = await res.json();
        await registrarLog(fiscalName, 'Operação Finalizada', `Salvou ${respData.itens_salvos || 0} infrações na ${operacaoId}.`);
        setHistoricoOps(prev => [novaOpCompleta, ...prev]);
        setOpSelecionadaIdx(0);
        setOperacaoId('');
        setLojasAuditadas([]);
        setActiveTab('historico');
      }
    } catch (e) {
      alert('Erro de conexão com a API Python.');
    } finally {
      setIsSyncing(false);
    }
