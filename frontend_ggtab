              </div>
              <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <table className="w-full text-left border-collapse text-sm">
                  <thead className="bg-slate-50 border-b border-slate-200 text-slate-500">
                    <tr>
                      <th className="p-4">Data / Hora</th>
                      <th className="p-4">Fiscal</th>
                      <th className="p-4">Ação</th>
                      <th className="p-4">Detalhes</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {loadingLogs ? (
                      <tr><td colSpan={4} className="p-8 text-center text-slate-400">Carregando logs...</td></tr>
                    ) : logsAuditoria.length === 0 ? (
                      <tr><td colSpan={4} className="p-8 text-center text-slate-400">Nenhum registro encontrado.</td></tr>
                    ) : (
                      logsAuditoria.map((log, i) => (
                        <tr key={i} className="hover:bg-slate-50">
                          <td className="p-4 font-mono text-xs text-slate-500">{new Date(log.data_hora).toLocaleString('pt-BR')}</td>
                          <td className="p-4 font-semibold text-slate-800">{log.fiscal}</td>
                          <td className="p-4"><span className="px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-bold">{log.acao}</span></td>
                          <td className="p-4 text-slate-600">{log.detalhes}</td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

        </div>
      </main>

      {/* MODAL 1: CADASTRAR NOVA MARCA GLOBAL */}
      {showModalCadastro && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-[#111827] w-full max-w-lg rounded-2xl shadow-2xl border border-slate-700 overflow-hidden flex flex-col max-h-[90vh]">
            <div className="flex items-center justify-between p-6 border-b border-slate-800">
              <h3 className="text-xl font-bold text-white flex items-center gap-2"><Plus className="text-blue-500" /> Cadastrar Nova Marca no Banco Global</h3>
              <button onClick={() => setShowModalCadastro(false)} className="text-slate-400 hover:text-white"><X size={24} /></button>
            </div>
            <div className="p-6 overflow-y-auto space-y-5">
              <div>
                <label className="text-sm font-medium text-slate-300">Categoria Macro</label>
                <select value={cadMacro} onChange={e => { setCadMacro(e.target.value); setCadTipo(''); }} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1">
                  <option value="">Selecione...</option>
                  <option value="💨 DEF (Dispositivos Eletrônicos para Fumar)">💨 DEF (Dispositivos Eletrônicos para Fumar)</option>
                  <option value="🍂 Tabacos e Derivados (Registrados pela ANVISA) - Propaganda Irregular">🍂 Tabacos e Derivados (Registrados pela ANVISA) - Propaganda Irregular</option>
                  <option value="🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão">🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão</option>
                  <option value="🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão e Propaganda">🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão e Propaganda</option>
                </select>
              </div>
              <div>
                <label className="text-sm font-medium text-slate-300">Tipo de Produto</label>
                <select value={cadTipo} onChange={e => setCadTipo(e.target.value)} disabled={!cadMacro} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1 disabled:opacity-50">
                  <option value="">{cadMacro ? "Selecione..." : "Aguardando Categoria..."}</option>
                  {opcoesTipoCadastro.map((t, i) => <option key={i} value={t}>{t}</option>)}
                </select>
              </div>
              {cadTipo === '+ Criar Novo Tipo' && (
                <div>
                  <label className="text-sm font-medium text-slate-300">Nome do Novo Tipo</label>
                  <input type="text" value={cadNovoTipo} onChange={e => setCadNovoTipo(e.target.value)} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1" />
                </div>
              )}
              <div>
                <label className="text-sm font-medium text-slate-300">Nome Comercial da Marca</label>
                <input type="text" value={cadMarca} onChange={e => setCadMarca(e.target.value)} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1" />
              </div>
              <div>
                <label className="text-sm font-medium text-slate-300">CNPJ (Se houver)</label>
                <input type="text" value={cadCnpj} onChange={e => setCadCnpj(e.target.value)} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-white font-mono mt-1" />
              </div>
            </div>
            <div className="p-6 border-t border-slate-800 bg-slate-900/50">
              <button onClick={submeterCadastroGlobal} className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl">Salvar no Banco Global</button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL 2: NOVA LOJA */}
      {showModalLoja && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-[#111827] text-white w-full max-w-md rounded-2xl shadow-2xl border border-slate-700 p-6">
            <div className="flex justify-between items-center mb-6 border-b border-slate-800 pb-4">
              <h3 className="text-xl font-bold">📍 Registrar Novo Estabelecimento</h3>
              <button onClick={() => setShowModalLoja(false)} className="text-slate-400 hover:text-white"><X size={22}/></button>
            </div>
            <form onSubmit={entrarNaLoja} className="space-y-4">
              <div>
                <label className="text-sm font-medium text-slate-300">Nº da Loja</label>
                <input type="number" min={1} value={formNumLoja} onChange={e => setFormNumLoja(parseInt(e.target.value) || 1)} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl mt-1 text-white" />
              </div>
              <div>
                <label className="text-sm font-medium text-slate-300">Endereço ou Nome Fantasia</label>
                <input type="text" value={formNomeLoja} onChange={e => setFormNomeLoja(e.target.value)} className="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl mt-1 text-white" required />
              </div>
              <button type="submit" className="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold mt-2">Iniciar Auditoria</button>
            </form>
          </div>
        </div>
      )}

      {/* MODAL 3: ADICIONAR INFRAÇÃO COM FOTOS E PYTESSERACT OCR */}
      {showModalInfracao && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-[#111827] text-white w-full max-w-xl rounded-2xl shadow-2xl border border-slate-700 flex flex-col max-h-[92vh]">
            <div className="flex justify-between items-center p-6 border-b border-slate-800">
              <h3 className="text-xl font-bold">📦 Adicionar Nova Infração / Apreensão</h3>
              <button onClick={() => { setShowModalInfracao(false); limparFormularioInfracao(); }} className="text-slate-400 hover:text-white"><X size={24}/></button>
            </div>
            
            <form onSubmit={confirmarInfracao} className="overflow-y-auto p-6 space-y-5">
              <div>
                <label className="text-sm font-medium text-slate-300">Categoria Macro da Infração</label>
                <select value={infMacro} onChange={e => { setInfMacro(e.target.value); setInfTipo(''); setInfProd(''); }} className="w-full p-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1">
                  <option value="">Selecione...</option>
                  <option value="💨 DEF (Dispositivos Eletrônicos para Fumar)">💨 DEF (Dispositivos Eletrônicos para Fumar)</option>
                  <option value="🍂 Tabacos e Derivados (Registrados pela ANVISA) - Propaganda Irregular">🍂 Tabacos e Derivados (Registrados pela ANVISA) - Propaganda Irregular</option>
                  <option value="🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão">🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão</option>
                  <option value="🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão e Propaganda">🍂 Tabacos e Derivados (Irregulares/Ilegais) - Apreensão e Propaganda</option>
                </select>
              </div>

              {infMacro !== '' && (
                <div>
                  <label className="text-sm font-medium text-slate-300">Tipo de Produto</label>
                  <select 
                    value={infTipo} 
                    onChange={e => { 
                      const val = e.target.value;
                      setInfTipo(val); 
                      setInfProd(val.includes("⚠️") ? "⚠️ CADASTRAR NOVA MARCA ILEGAL" : '');
                    }} 
                    className="w-full p-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1"
                  >
                    <option value="">Selecione...</option>
                    {opcoesTipoInfracao.map((t, idx) => <option key={idx} value={t}>{t}</option>)}
                  </select>
                </div>
              )}

              {infTipo !== '' && !isNovoTipoSelecionado && (
                <div>
                  <label className="text-sm font-medium text-slate-300">{isPropaganda ? "Busque o Produto Registrado" : "Selecione a Marca"}</label>
                  <select value={infProd} onChange={e => setInfProd(e.target.value)} className="w-full p-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white mt-1">
                    <option value="">Selecione...</option>
                    {produtosFiltradosInfracao.map((p, idx) => (
                      <option key={idx} value={p.produto}>{p.produto} {p.cnpj && p.cnpj !== 'Sem CNPJ' ? `— [${p.cnpj}]` : ''}</option>
                    ))}
                    {(isIlegal || isDef || isAmbos) && <option value="⚠️ CADASTRAR NOVA MARCA ILEGAL">⚠️ CADASTRAR NOVA MARCA ILEGAL</option>}
                  </select>
                </div>
              )}

              {infProd !== '' && infProd !== "⚠️ CADASTRAR NOVA MARCA ILEGAL" && !isNovoTipoSelecionado && (
                <div className="p-3.5 bg-slate-800/80 border border-slate-700 rounded-xl flex items-center justify-between text-sm">
                  <span className="text-slate-400">CNPJ Vinculado na Base ANVISA:</span>
                  <span className="font-mono font-bold text-emerald-400">{cnpjBancoSelecionado}</span>
                </div>
              )}

              {(infProd !== '' || isNovoTipoSelecionado) && (
                <div className="space-y-5">
                  <div>
                    <label className="text-sm font-medium text-slate-300">Quantidade (Unidades/Peças)</label>
                    <input type="number" min={1} value={infQtd} onChange={e => setInfQtd(parseInt(e.target.value) || 1)} className="w-full p-3.5 bg-slate-800 border border-slate-700 rounded-xl mt-1 text-white font-bold" />
                  </div>

                  <div>
                    <label className="text-sm font-medium text-slate-300 block mb-2">Captura de Evidências (Integradas ao PDF)</label>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      <label className="flex flex-col items-center justify-center h-32 border-2 border-slate-700 border-dashed rounded-xl cursor-pointer bg-slate-800/50 hover:bg-slate-800 relative overflow-hidden">
                        {foto1Preview ? (
                          <img src={foto1Preview} className="absolute inset-0 w-full h-full object-cover" alt="Foto 1" />
                        ) : (
                          <div className="flex flex-col items-center justify-center p-4 text-slate-400 text-center">
                            <Camera className="w-7 h-7 mb-1.5 text-blue-400" />
                            <span className="text-xs font-semibold">1 - Embalagem Frontal / Propaganda</span>
                          </div>
                        )}
                        <input type="file" accept="image/*" capture="environment" onChange={e => handleCaptureFoto(e, 1)} className="hidden" />
                      </label>

                      <label className="flex flex-col items-center justify-center h-32 border-2 border-slate-700 border-dashed rounded-xl cursor-pointer bg-slate-800/50 hover:bg-slate-800 relative overflow-hidden">
                        {foto2Preview ? (
                          <img src={foto2Preview} className="absolute inset-0 w-full h-full object-cover" alt="Foto 2" />
                        ) : (
                          <div className="flex flex-col items-center justify-center p-4 text-slate-400 text-center">
                            <Camera className="w-7 h-7 mb-1.5 text-emerald-400" />
                            <span className="text-xs font-semibold">2 - Lote / CNPJ / Detalhes (OCR)</span>
                          </div>
                        )}
                        <input type="file" accept="image/*" capture="environment" onChange={e => handleCaptureFoto(e, 2)} className="hidden" />
                      </label>
                    </div>

                    {foto2Preview && (
                      <div className="mt-3 space-y-2">
                        <button type="button" onClick={executarOcrCnpj} disabled={loadingOcr} className="w-full py-2.5 px-4 bg-slate-800 hover:bg-slate-700 border border-emerald-500/40 text-emerald-400 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all">
                          <ScanLine size={16} />
                          {loadingOcr ? "A analisar imagem com Pytesseract..." : "🤖 Tentar Auto-Preencher CNPJ da Foto 2 (Pytesseract OCR)"}
                        </button>
                        {ocrFeedback && <div className="text-xs text-center font-medium text-amber-300">{ocrFeedback}</div>}
                      </div>
                    )}
                  </div>

                  {(isNovoTipoSelecionado || infProd === "⚠️ CADASTRAR NOVA MARCA ILEGAL") && (
                    <div className="p-4 bg-slate-800/60 border border-amber-500/40 rounded-xl space-y-4">
                      <div className="text-xs font-bold text-amber-400 uppercase">⚠️ Dados da Nova Marca Ilegal</div>
                      <div>
                        <label className="text-xs text-slate-300">Nome da Nova Marca Ilegal</label>
                        <input type="text" value={infNovoNome} onChange={e => setInfNovoNome(e.target.value)} className="w-full p-3 bg-slate-900 border border-slate-700 rounded-xl mt-1 text-white" required />
                      </div>
                      <div>
                        <label className="text-xs text-slate-300">CNPJ Falso / Extraído pelo OCR (Opcional)</label>
                        <input type="text" value={infNovoCnpj} onChange={e => setInfNovoCnpj(e.target.value)} className="w-full p-3 bg-slate-900 border border-slate-700 rounded-xl mt-1 text-white font-mono" placeholder="Sem CNPJ" />
                      </div>
                      {isNovoTipoSelecionado && (
                        <div>
                          <label className="text-xs text-slate-300">Tipo Específico</label>
                          <input type="text" value={infNovoTipo} onChange={e => setInfNovoTipo(e.target.value)} className="w-full p-3 bg-slate-900 border border-slate-700 rounded-xl mt-1 text-white" required />
                        </div>
                      )}
                    </div>
                  )}

                  <button type="submit" className="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold shadow-lg">
                    ➕ Confirmar Infração
                  </button>
                </div>
              )}
            </form>
          </div>
        </div>
      )}

    </div>
  );
}
