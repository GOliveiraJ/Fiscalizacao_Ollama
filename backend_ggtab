@app.get("/api/dashboard")
def obter_dados_dashboard():
    if not HAS_SUPABASE:
        return {"total_operacoes": 0, "total_lojas": 0, "total_itens": 0, "total_ilegais": 0}
    try:
        resposta = supabase.table("apreensoes").select("*").execute()
        dados = resposta.data
        if not dados:
            return {"total_operacoes": 0, "total_lojas": 0, "total_itens": 0, "total_ilegais": 0}

        operacoes_unicas = set()
        lojas_unicas = set()
        total_itens = 0
        total_ilegais = 0

        for row in dados:
            operacoes_unicas.add(row.get('operacao_id'))
            lojas_unicas.add(row.get('loja'))
            qtd = int(row.get('quantidade', 0))
            total_itens += qtd
            status = str(row.get('status', '')).lower()
            if 'ilegal' in status or 'propaganda' in status:
                total_ilegais += qtd

        return {
            "total_operacoes": len(operacoes_unicas),
            "total_lojas": len(lojas_unicas),
            "total_itens": total_itens,
            "total_ilegais": total_ilegais
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

