# ROTA: OCR DE IMAGEM (PYTESSERACT)
# ==========================================
@app.post("/api/ocr-cnpj")
def ler_cnpj_ocr(req: OcrRequest):
    if not HAS_OCR:
        return {"sucesso": False, "mensagem": "Biblioteca pytesseract não instalada no servidor."}
    
    img_bytes = decode_base64_image(req.imagem_base64)
    if not img_bytes:
        return {"sucesso": False, "mensagem": "Imagem inválida."}

    try:
        img = Image.open(io.BytesIO(img_bytes))
        texto_extraido = pytesseract.image_to_string(img)
        numeros = re.sub(r'\D', '', texto_extraido)
        
        mapa_cnpj = obter_mapa_cnpj()
        # 1. Procura se algum CNPJ oficial do banco está nos números lidos
        for cnpj_limpo, info in mapa_cnpj.items():
            if cnpj_limpo in numeros:
                return {
                    "sucesso": True,
                    "cnpj": info["cnpj_formatado"],
                    "produto_sugerido": info["produto"],
                    "mensagem": f"CNPJ oficial identificado: {info['cnpj_formatado']}"
                }
        
        # 2. Procura padrão de CNPJ formatado ou 14 dígitos na imagem
        match_formatado = re.search(r'\d{2}[\.\s]?\d{3}[\.\s]?\d{3}[\/\s]?\d{4}[-\s]?\d{2}', texto_extraido)
        if match_formatado:
            cnpj_lido = re.sub(r'\D', '', match_formatado.group(0))
            if len(cnpj_lido) == 14:
                cnpj_fmt = f"{cnpj_lido[:2]}.{cnpj_lido[2:5]}.{cnpj_lido[5:8]}/{cnpj_lido[8:12]}-{cnpj_lido[12:]}"
                return {"sucesso": True, "cnpj": cnpj_fmt, "produto_sugerido": None, "mensagem": f"CNPJ lido da embalagem: {cnpj_fmt}"}

        match_14 = re.search(r'\d{14}', numeros)
        if match_14:
            c = match_14.group(0)
            cnpj_fmt = f"{c[:2]}.{c[2:5]}.{c[5:8]}/{c[8:12]}-{c[12:]}"
            return {"sucesso": True, "cnpj": cnpj_fmt, "produto_sugerido": None, "mensagem": f"Sequência de CNPJ lida: {cnpj_fmt}"}

        return {"sucesso": False, "mensagem": "Nenhum CNPJ nítido encontrado na imagem."}
    except Exception as e:
        return {"sucesso": False, "mensagem": f"Falha no motor OCR (Verifique o Tesseract no Windows): {str(e)}"}

