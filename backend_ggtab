@app.post("/api/chat", response_model=ChatResponse)
def motor_juridico_chat(request: ChatRequest):
    pergunta = request.prompt.lower()
    prompt_limpo = pergunta.replace(".", "").replace("/", "").replace("-", "")
    numeros_pergunta = re.sub(r'\D', '', prompt_limpo)
    palavras_pergunta = set(re.findall(r'\b\w+\b', pergunta))
    palavras_ignoradas = {'para', 'como', 'sabor', 'menta', 'qual', 'quais', 'onde', 'legal', 'ilegal', 'cnpj', 'cnpjs', 'empresa', 'empresas', 'marca', 'marcas', 'produto', 'produtos', 'registro', 'registrado'}

    cnpjs_alvo = set()
    empresas_alvo_ilegais = set()
    
    for cat, tipos in DB_PRODUTOS_BASE.items():
        for tipo, produtos in tipos.items():
            for prod_full, cnpj in produtos.items():
                cnpj_num = re.sub(r'\D', '', cnpj)
                match_parenteses = re.match(r'^(.*?)\s*\((.*?)\)$', prod_full)
                marca = match_parenteses.group(1).strip().lower() if match_parenteses else prod_full.lower()
                empresa = match_parenteses.group(2).strip().lower() if match_parenteses else ""
                empresa_limpa = empresa.replace(" ltda", "").replace(" eireli", "").replace(" s.a.", "").replace(" - me", "").replace(".", "").strip()

                is_match = False
                if len(numeros_pergunta) >= 8 and cnpj_num and (numeros_pergunta in cnpj_num or cnpj_num in numeros_pergunta):
                    is_match = True
                else:
                    for p in palavras_pergunta:
                        if p not in palavras_ignoradas and len(p) > 3:
                            if p in marca.split() or (empresa_limpa and p in empresa_limpa.split()):
                                is_match = True
                                break
                if is_match:
                    if "Ilegal" not in cnpj: cnpjs_alvo.add(cnpj)
                    else: empresas_alvo_ilegais.add(marca)

    empresas_encontradas = {}
    for cat, tipos in DB_PRODUTOS_BASE.items():
        for tipo, produtos in tipos.items():
            for prod_full, cnpj in produtos.items():
                match_parenteses = re.match(r'^(.*?)\s*\((.*?)\)$', prod_full)
                marca_exibicao = match_parenteses.group(1).strip() if match_parenteses else prod_full
                empresa_exibicao = match_parenteses.group(2).strip() if match_parenteses else "Marca Independente"
                if cnpj in cnpjs_alvo or marca_exibicao.lower() in empresas_alvo_ilegais:
                    chave = cnpj if "Ilegal" not in cnpj else marca_exibicao
                    if chave not in empresas_encontradas:
                        status_str = "✅ REGISTRADO" if "Ilegal" not in cnpj else "❌ ILEGAL (Clandestino)"
                        empresas_encontradas[chave] = {"empresa": empresa_exibicao, "cnpj": cnpj, "status": status_str, "produtos": []}
                    empresas_encontradas[chave]["produtos"].append(f"- {marca_exibicao} ({tipo})")

    texto_banco_para_tela = ""
    contexto_banco_para_ia = ""
    if empresas_encontradas:
        texto_banco_para_tela = "### 🏢 Dossiê Corporativo\n\n"
        for chave, dados in empresas_encontradas.items():
            texto_banco_para_tela += f"**Fabricante:** {dados['empresa']}\n**CNPJ:** {dados['cnpj']}\n**Status:** {dados['status']}\n**Portfólio:**\n" 
            texto_banco_para_tela += "\n".join(dados['produtos'][:10]) + "\n\n"
            contexto_banco_para_ia += f"Empresa: {dados['empresa']}, CNPJ: {dados['cnpj']}, Status: {dados['status']}.\n"

    system_prompt = f"""Você é o Procurador Jurídico Especialista da GGTAB (ANVISA). Responda de forma curta em Markdown.
Leis base: RDC 855/2024 (Proíbe Vapes), RDC 840/2023 (Proíbe Propaganda), RDC 896/2024 (Exige Registro), Lei 6.437/1977.
Informação do Banco de Dados: [{contexto_banco_para_ia}]"""

    try:
        resposta_ollama = ollama.chat(model='llama3.2', messages=[{'role': 'system', 'content': system_prompt}, {'role': 'user', 'content': request.prompt}], options={'temperature': 0.1})
        parecer_ia = resposta_ollama['message']['content']
    except Exception as e:
        parecer_ia = f"Erro no Ollama: {e}"

    return ChatResponse(dossie_banco=texto_banco_para_tela, parecer_ia=parecer_ia)
