@app.get("/api/operacoes")
def listar_operacoes():
    if not HAS_SUPABASE:
        return {"operacoes": []}
    try:
        resp = supabase.table("apreensoes").select("*").order("data_hora", desc=True).execute()
        ops_map = {}
        for row in resp.data:
            op_id = row.get("operacao_id", "OP-Sem-ID")
            if op_id not in ops_map:
                ops_map[op_id] = {
                    "operacao_id": op_id,
                    "fiscal": row.get("fiscal", "Fiscal GGTAB"),
                    "data_hora": row.get("data_hora", ""),
                    "lojas_map": {}
                }
            loja_str = row.get("loja", "Loja 1 - Estabelecimento")
            match_loja = re.match(r'^Loja\s+(\d+)\s*-\s*(.*)$', loja_str)
            num_loja = int(match_loja.group(1)) if match_loja else 1
            nome_loja = match_loja.group(2).strip() if match_loja else loja_str

            if loja_str not in ops_map[op_id]["lojas_map"]:
                ops_map[op_id]["lojas_map"][loja_str] = {
                    "numero": num_loja,
                    "nome": nome_loja,
                    "itens": []
                }
            ops_map[op_id]["lojas_map"][loja_str]["itens"].append({
                "categoria": row.get("categoria", ""),
                "tipo": row.get("tipo", ""),
                "produto": row.get("produto", ""),
                "status": row.get("status", ""),
                "cnpj": row.get("cnpj", "Sem CNPJ"),
                "quantidade": int(row.get("quantidade", 1)),
                "hora": ""
            })

        lista_ops = []
        for op_id, dados in ops_map.items():
            lista_ops.append({
                "operacao_id": dados["operacao_id"],
                "fiscal": dados["fiscal"],
                "data_hora": dados["data_hora"],
                "lojas": list(dados["lojas_map"].values())
            })
        return {"operacoes": lista_ops}
    except Exception as e:
        print(f"Erro ao listar operações: {e}")
        return {"operacoes": []}

@app.post("/api/salvar-operacao")
def salvar_operacao(req: OperacaoRequest):
    if not HAS_SUPABASE:
        return {"status": "sucesso_local", "itens_salvos": sum(len(l.itens) for l in req.lojas)}
    
    dados_insercao = []
    data_agora = datetime.now().isoformat()
    try:
        # Remove registros anteriores do mesmo operacao_id (suporta criação e edição!)
        supabase.table("apreensoes").delete().eq("operacao_id", req.operacao_id).execute()

        for loja in req.lojas:
            for item in loja.itens:
                dados_insercao.append({
                    "operacao_id": req.operacao_id,
                    "data_hora": data_agora,
                    "fiscal": req.fiscal,
                    "loja": f"Loja {loja.numero} - {loja.nome}",
                    "categoria": item.categoria,
                    "tipo": item.tipo,
                    "produto": item.produto,
                    "cnpj": item.cnpj.replace(" [Ilegal]", ""),
                    "status": item.status,
                    "quantidade": item.quantidade
