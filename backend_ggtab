@app.post("/api/exportar-excel")
def exportar_excel(req: OperacaoRequest):
    flat_data = []
    for loja in req.lojas:
        for item in loja.itens:
            flat_data.append({
                "Loja": f"Loja {loja.numero} - {loja.nome}",
                "Categoria": item.categoria,
                "Tipo": item.tipo,
                "Produto": item.produto,
                "Status": item.status,
                "CNPJ Identificado": item.cnpj.replace(" [Ilegal]", ""),
                "Quantidade": item.quantidade,
                "Hora": item.hora or datetime.now().strftime('%H:%M:%S'),
                "Fundamentação Legal": obter_fundamentacao_legal(item.categoria, item.status)
            })
    
    df = pd.DataFrame(flat_data)
    out = io.BytesIO()
    with pd.ExcelWriter(out, engine='openpyxl') as writer:
        if df.empty:
            pd.DataFrame({"Aviso": ["Nenhuma apreensão registrada nesta operação."]}).to_excel(writer, index=False, sheet_name='Sem_Apreensoes')
        else:
            for lname in df['Loja'].unique():
                aba_limpa = ''.join(c for c in clean_text_for_pdf(lname) if c.isalnum() or c.isspace() or c == '-').strip()[:31] or "Loja"
                df[df['Loja'] == lname].to_excel(writer, index=False, sheet_name=aba_limpa)
    
    out.seek(0)
    headers = {'Content-Disposition': f'attachment; filename="{req.operacao_id}.xlsx"'}
    return StreamingResponse(out, media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", headers=headers)

