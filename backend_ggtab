@app.post("/api/exportar-pdf")
def exportar_pdf(req: OperacaoRequest):
    pdf = FPDF()
    pdf.add_page()
    pdf.set_font("helvetica", style="B", size=15)
    pdf.cell(0, 10, clean_text_for_pdf("Auto de Inspecao e Apreensao - GGTAB/ANVISA"), ln=True, align='C')
    pdf.set_font("helvetica", size=9)
    pdf.cell(0, 8, clean_text_for_pdf(f"Operacao: {req.operacao_id} | Fiscal: {req.fiscal} | Data: {datetime.now().strftime('%d/%m/%Y %H:%M')}"), ln=True, align='C')
    pdf.line(10, 28, 200, 28)
    pdf.ln(8)

    if not req.lojas:
        pdf.cell(0, 10, "Nenhuma loja fiscalizada nesta operacao.", ln=True)
    else:
        for loja in req.lojas:
            pdf.set_font("helvetica", style="B", size=13)
            pdf.set_text_color(0, 51, 102)
            pdf.cell(0, 10, clean_text_for_pdf(f"Estabelecimento: Loja {loja.numero} - {loja.nome}"), ln=True)
            pdf.set_text_color(0, 0, 0)

            if not loja.itens:
                pdf.set_font("helvetica", style="I", size=10)
                pdf.cell(0, 6, "Nenhum item apreendido.", ln=True)
                pdf.ln(4)
                continue

            for item in loja.itens:
                if pdf.get_y() > 240:
                    pdf.add_page()
                pdf.set_font("helvetica", style="B", size=11)
                hora_str = f" (Hora: {item.hora})" if item.hora else ""
                pdf.cell(0, 7, clean_text_for_pdf(f"Item: {item.produto}{hora_str}"), ln=True)
                
                pdf.set_font("helvetica", size=10)
                pdf.cell(0, 6, clean_text_for_pdf(f"Categoria: {item.categoria} | Tipo: {item.tipo}"), ln=True)

                qtd_str = f"Qtd: {item.quantidade} und. | Status: {item.status}"
                if "Propaganda" in item.categoria or "Propaganda" in item.status:
                    qtd_str = f"Pecas Publicitarias / Qtd: {item.quantidade} | Status: {item.status}"
                pdf.cell(0, 6, clean_text_for_pdf(qtd_str), ln=True)

                pdf.set_font("helvetica", style="B", size=10)
                pdf.cell(0, 6, clean_text_for_pdf(f"CNPJ / Lote: {item.cnpj.replace(' [Ilegal]', '')}"), ln=True)

                fund = obter_fundamentacao_legal(item.categoria, item.status)
                pdf.set_font("helvetica", style="I", size=9)
                if "Ilegal" in item.status or "Propaganda" in item.status:
                    pdf.set_text_color(200, 0, 0)
                else:
                    pdf.set_text_color(0, 100, 0)
                pdf.cell(0, 6, clean_text_for_pdf(f"Fundamentacao Legal: {fund}"), ln=True)
                pdf.set_text_color(0, 0, 0)

                f1_bytes = decode_base64_image(item.foto1_base64)
                f2_bytes = decode_base64_image(item.foto2_base64)

                if f1_bytes or f2_bytes:
                    pdf.ln(2)
                    if pdf.get_y() > 220:
                        pdf.add_page()
                    y_atual = pdf.get_y()
                    x_offset = 10
                    if f1_bytes:
                        try:
                            pdf.image(io.BytesIO(f1_bytes), x=x_offset, y=y_atual, w=50, h=45)
                            x_offset += 60
                        except Exception:
                            pass
                    if f2_bytes:
                        try:
                            pdf.image(io.BytesIO(f2_bytes), x=x_offset, y=y_atual, w=50, h=45)
                        except Exception:
                            pass
                    pdf.ln(48)
                else:
                    pdf.ln(2)

                pdf.line(10, pdf.get_y(), 200, pdf.get_y())
                pdf.ln(4)

    pdf_bytes = bytes(pdf.output())
    headers = {'Content-Disposition': f'attachment; filename="{req.operacao_id}.pdf"'}
    return StreamingResponse(io.BytesIO(pdf_bytes), media_type="application/pdf", headers=headers)

